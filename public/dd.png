<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <style> .b{fill:#000} .w{fill:#fff} </style>
  </defs>
  <rect width="100%" height="100%" fill="none"/>
  <circle class="b" cx="256" cy="256" r="240"/>
  <!-- door / cutout -->
  <rect class="w" x="196" y="300" width="120" height="160" rx="60"/>
  <!-- diagonal element (hand) -->
  <rect class="w" x="220" y="150" width="180" height="28" rx="14" transform="rotate(30 310 164)"/>
  <!-- small stub to the right -->
  <rect class="w" x="378" y="186" width="40" height="18" rx="9" transform="rotate(10 398 195)"/>
</svg>
